# Провайдер LLM: openrouter | openai | gemini | mock (тестовий, без мережі)
VITE_AI_PROVIDER=openrouter
# Будь-який OpenAI-сумісний API: достатньо змінити адресу, ключ і модель
VITE_LLM_BASE_URL=https://openrouter.ai/api/v1
VITE_LLM_API_KEY=your-api-key-here
VITE_LLM_MODEL=mistralai/mistral-7b-instruct:free

# Старі змінні прототипу теж підтримуються:
# VITE_OPENROUTER_API_KEY=...
# VITE_OPENROUTER_MODEL=...
# VITE_GEMINI_API_KEY=...
# VITE_GEMINI_MODEL=...
